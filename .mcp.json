{
  "mcpServers": {
    "playwright-neo": {
      "command": "sh",
      "args": [
        "-c",
        "P=$(node -p \"try{require(require('os').homedir()+'/Library/Application Support/BrowserClaw/.browseros/config.json').ports.cdp||9110}catch(e){9110}\"); exec npx -y @playwright/mcp@latest --cdp-endpoint http://127.0.0.1:$P"
      ],
      "type": "stdio"
    },
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ],
      "type": "stdio"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "type": "stdio"
    }
  }
}
