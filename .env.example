# ERDD 환경 변수 예시. 이 파일을 `.env` 로 복사해 값을 채운다.
# `.env` 는 저장소에 커밋되지 않는다(.gitignore).
#
# 주의: 서버는 `.env` 를 스스로 읽지 않는다(dotenv 를 쓰지 않는다).
#   - docker compose 는 같은 디렉터리의 `.env` 를 자동으로 읽어 값을 치환한다.
#   - 소스에서 직접 실행할 때는 셸에서 export 하거나 systemd 의 EnvironmentFile 로 넘긴다.
#   - 단, 개발용 루트 `pnpm dev` 는 편의를 위해 이 파일을 셸에 로드한 뒤 dev 프로세스를 띄운다
#     (`.env` 가 없으면 아무 말 없이 그대로 뜬다). 서버가 읽는 것이 아니라 스크립트가 넣어 주는 것이다.
#     **이 파일에 적힌 키가 이긴다** — `PORT=3001 pnpm dev` 처럼 인라인으로 준 값도 아래에 같은 키가
#     있으면 덮인다. 여기 없는 키는 인라인으로 준 값이 그대로 산다.
# 자세한 설명은 docs/manual/install.md 5절 "환경 변수".

# ── 서버 ──────────────────────────────────────────────────────────────────────

# [필수] PostgreSQL 접속 문자열. 없으면 서버는 뜨지만 모든 tRPC 호출이 412 를 반환하고
# 화면에는 "연결에 문제가 있습니다" 가 뜬다. `drizzle-kit migrate` 도 이 값을 쓴다.
# compose 로 앱까지 띄울 때 컨테이너 안에서 쓰는 값은 docker-compose.yml 의 app 서비스에
# 따로 박혀 있다(호스트명이 db 다). 아래 값은 호스트에서 마이그레이션·psql 을 돌릴 때 쓴다.
DATABASE_URL=postgres://postgres:erdd@localhost:5432/erdd

# [선택] 서버가 listen 하는 포트. 기본 3000. 소스에서 직접 실행할 때(방법 B)만 쓴다 —
# compose 는 이 값을 앱 컨테이너에 넘기지 않으므로, 방법 A 에서는 아래 ERDD_PORT 를 쓴다.
# 주석을 풀면 루트 `pnpm dev` 에서 인라인 포트 지정(`PORT=3001 pnpm dev`)이 무력화된다 — 워크트리 격리가 깨진다.
#PORT=3000

# [선택] production 일 때만 세션 쿠키에 Secure 가 붙는다(그 자리는 한 곳뿐이다 —
# apps/server/src/routers/auth.ts 의 auth.login). 그래서 HTTPS 가 전제다: 평문 HTTP 로
# 서비스하면 브라우저가 쿠키를 저장하지 않아 로그인이 되지 않는다.
# Docker 이미지에는 production 이 박혀 있다. **compose 로 띄울 때 이 변수는 쓰이지 않는다** —
# 아래 ERDD_NODE_ENV 를 쓴다. 여기 값이 필요한 것은 소스에서 직접 실행할 때(방법 B)다.
#NODE_ENV=production

# ── 최초 관리자 부트스트랩(선택) ───────────────────────────────────────────────
# 둘 다 있어야 동작한다. 해당 이메일의 계정이 없을 때만 admin 으로 만들고,
# 이미 있으면 아무것도 하지 않는다(비밀번호를 덮어쓰지 않는다).
# 첫 관리자를 만든 뒤에는 지워도 된다.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ── docker compose 전용 ───────────────────────────────────────────────────────
# 아래 셋은 compose 가 읽어 치환하는 값이다. 앱·서버는 이 이름들을 모른다.

# [선택] compose 의 db 서비스와 app 의 DATABASE_URL 이 함께 쓰는 비밀번호. 기본 erdd.
# 운영 설치라면 **첫 기동 전에** 바꾼다 — 이 값은 데이터 디렉터리를 처음 초기화할 때만
# 반영되고, pgdata 볼륨이 이미 있으면 바꿔도 실제 비밀번호는 그대로다(실측 확인).
# @ : / # ? 는 접속 URL 을 깨뜨린다. 퍼센트 인코딩하거나 그런 문자를 피한다.
#POSTGRES_PASSWORD=erdd

# [선택] 앱 컨테이너를 호스트의 어느 포트에 붙일지. 기본 3000.
#ERDD_PORT=3000

# [선택] 앱 컨테이너의 NODE_ENV. 기본 production. TLS 없이 시험할 때만 development 로
# 내린다(세션 쿠키에서 Secure 가 빠져 평문 HTTP 로도 로그인이 된다). 운영에서는 건드리지 않는다.
# 이름이 NODE_ENV 가 아닌 것은 의도다 — 그러면 셸에 우연히 남은 NODE_ENV 가 흘러들어
# Secure 가 조용히 꺼진다.
#ERDD_NODE_ENV=production

# ── CLI 전용(서버와 무관) ─────────────────────────────────────────────────────
# erdd CLI 가 쓸 액세스 토큰. 서버에는 아무 영향이 없다(→ docs/manual/cli-guide.md).
#ERDD_TOKEN=
