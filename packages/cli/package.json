{
  "name": "@erdd/cli",
  "version": "0.2.0",
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "bin": {
    "erdd": "./src/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "skill",
    "web",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.develma.com/app/erdd.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle:web": "node scripts/bundle-web.mjs",
    "bundle:docs": "node scripts/bundle-docs.mjs",
    "prepack": "node scripts/check-web-bundle.mjs && node scripts/bundle-docs.mjs"
  },
  "dependencies": {
    "@erdd/core": "workspace:^",
    "@fastify/static": "^10.1.2",
    "@trpc/server": "^11.18.0",
    "fastify": "^5.10.0",
    "uuidv7": "^1.2.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@erdd/server": "workspace:^",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
