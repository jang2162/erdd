{
  "name": "@erdd/cli",
  "version": "0.6.0",
  "description": "ERDD command-line tool that keeps your ER model as YAML files in your repository and lets you edit them in a browser GUI",
  "keywords": [
    "cli",
    "database",
    "ddl",
    "er-diagram",
    "erd",
    "schema",
    "yaml"
  ],
  "homepage": "https://github.com/jang2162/erdd/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/jang2162/erdd/issues"
  },
  "license": "MIT",
  "author": "장병현",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jang2162/erdd.git",
    "directory": "packages/cli"
  },
  "bin": {
    "erdd": "./src/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "skill",
    "web",
    "docs",
    "README.ko.md"
  ],
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle:web": "node scripts/bundle-web.mjs",
    "bundle:docs": "node scripts/bundle-docs.mjs",
    "prepack": "node scripts/check-web-bundle.mjs && node scripts/bundle-docs.mjs"
  },
  "dependencies": {
    "@erdd/core": "workspace:^",
    "@fastify/static": "^10.1.2",
    "@trpc/server": "^11.18.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.10.0",
    "uuidv7": "^1.2.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@erdd/server": "workspace:^",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
